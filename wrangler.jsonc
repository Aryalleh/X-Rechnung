{
  // ---------------------------------------------------------------------------
  // X-Rechnung — Cloudflare Workers configuration
  //
  // IMPORTANT (per specification amendment):
  //   NO business/tenant configuration is hardcoded here. Owner email, app name,
  //   domains, tax numbers, invoice texts, email addresses, validator URLs etc.
  //   are all configured from the admin panel and stored (encrypted where secret)
  //   in D1. Only infrastructure bindings and non-business bootstrap values live
  //   in this file / in `wrangler secret`.
  // ---------------------------------------------------------------------------
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "x-rechnung",
  "main": "src/worker.ts",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": ["nodejs_compat"],

  "observability": {
    "enabled": true
  },

  // Non-business bootstrap var only. Everything else comes from D1 settings.
  "vars": {
    "ENVIRONMENT": "development"
  },

  // Frontend (React/Vite build output) served as static assets.
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },

  // D1 — create with EU jurisdiction:
  //   wrangler d1 create x-rechnung --location=weur
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "x-rechnung",
      "database_id": "973560a3-e3d7-4cd2-9799-05c6e598d827",
      "migrations_dir": "migrations"
    }
  ],

  // R2 — create with EU jurisdiction:
  //   wrangler r2 bucket create x-rechnung-archive --jurisdiction eu
  "r2_buckets": [
    {
      "binding": "ARCHIVE_BUCKET",
      "bucket_name": "x-rechnung-archive",
      "jurisdiction": "eu"
    }
  ],

  "durable_objects": {
    "bindings": [
      {
        "name": "INVOICE_SEQUENCE",
        "class_name": "InvoiceSequence"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["InvoiceSequence"]
    }
  ],

  "queues": {
    "producers": [
      {
        "binding": "DOCUMENT_QUEUE",
        "queue": "x-rechnung-documents"
      }
    ],
    "consumers": [
      {
        "queue": "x-rechnung-documents",
        "max_batch_size": 10,
        "max_batch_timeout": 30,
        "max_retries": 5,
        "dead_letter_queue": "x-rechnung-documents-dlq"
      }
    ]
  },

  // Browser Rendering binding (PDF generation from HTML).
  "browser": {
    "binding": "BROWSER"
  },

  // Outbound email via Cloudflare Email routing send binding.
  // The destination address must be a verified destination in Email Routing.
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],

  // Daily cron: overdue check, retry failed jobs, hash/metadata integrity, manifest.
  "triggers": {
    "crons": ["0 3 * * *"]
  }
}
