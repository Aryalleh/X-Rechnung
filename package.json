{
  "name": "x-rechnung",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Invoice system for German Freiberufler / Kleinunternehmer (§19 UStG) on Cloudflare Workers",
  "scripts": {
    "dev": "vite build --watch & wrangler dev",
    "build": "npm install --no-save --no-audit --no-fund wrangler@4.157.0 && vite build",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate:local": "wrangler d1 migrations apply DB --local",
    "migrate:remote": "wrangler d1 migrations apply DB --remote",
    "seed:local": "wrangler d1 execute DB --local --file=./migrations/seed.sql"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "^0.0.14",
    "hono": "^4.6.14",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.5.40",
    "@cloudflare/workers-types": "^4.20250109.0",
    "@hono/vite-build": "^1.2.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^2.1.8",
    "wrangler": "^3.99.0"
  }
}
